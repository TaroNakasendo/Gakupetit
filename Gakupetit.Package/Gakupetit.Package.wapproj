<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Packaging project for MSIX. Open this project in Visual Studio and use "Associate App with the Store" to configure Identity/Publisher. -->
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
    <PackageCertificateKeyFile>gakupetit-test.pfx</PackageCertificateKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the main application project -->
    <ProjectReference Include="..\Gakupetit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Package.appxmanifest" />
    <None Include="Readme.md" />
  </ItemGroup>
</Project>